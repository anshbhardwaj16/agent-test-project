#!/usr/bin/env bash
# omnispark pre-commit hook — runs the routing-docs validator.
#
# This file is the canonical hook source. Each registered project repo
# points its core.hooksPath at <workspace>/.omnispark-hooks/<repo>/ which
# is generated by install.py and contains a copy of (or symlink to) this
# file. That keeps every repo in lock-step with the framework version.
#
# Behaviour:
#   - Runs only when README.md or CONTRIBUTING.md is in the commit
#   - On ERROR, blocks the commit and prints how to fix it
#   - On WARN, allows the commit, prints advisories
#   - Set OMNISPARK_SKIP_HOOK=1 to bypass (use sparingly; CI will still gate)
#
# Output:
#   - Interactive TTY (developer in a terminal): rich block with framework
#     version banner, per-gate timing, and an explicit PASS/BLOCK verdict.
#     Wrapped in <<OMNISPARK-VISIBLE-BEGIN/END>> markers so it surfaces in
#     Copilot Chat / web Claude where tool-result blocks are hidden.
#   - CI ($CI or $GITHUB_ACTIONS set), or OMNISPARK_HOOK_QUIET=1: drops to
#     compact line-per-event logs that CI artifact viewers handle nicely.
#   - OMNISPARK_SKIP_HOOK=1: single-line "skipped" notice and exit.

set -e

# Skip switch (escape hatch — discouraged but pragmatic).
if [ "${OMNISPARK_SKIP_HOOK:-0}" = "1" ]; then
    echo "[omnispark/pre-commit] skipped (OMNISPARK_SKIP_HOOK=1)"
    exit 0
fi

# Visibility mode. Rich blocks for interactive TTYs (where a human is
# watching); compact line logs for CI artifact viewers (where every
# stdout line becomes its own log row and ASCII art is noise).
if [ -n "${OMNISPARK_HOOK_QUIET+x}" ]; then
    HOOK_QUIET="$OMNISPARK_HOOK_QUIET"     # explicit override wins
elif [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ]; then
    HOOK_QUIET="1"                          # CI runners: compact
elif [ -t 1 ]; then
    HOOK_QUIET="0"                          # interactive TTY: rich
else
    HOOK_QUIET="1"                          # non-TTY, non-CI: compact
fi

# Visible-marker helpers. The framework's `visible_output.py` module
# emits the same markers from Python; we use the bash equivalent here
# so hook output lands in surfaces that hide raw tool-result blocks
# (some IDE Copilot Chats, collapsed web Claude views).
visible_begin() { [ "$HOOK_QUIET" = "0" ] && echo "<<OMNISPARK-VISIBLE-BEGIN>>"; }
visible_end()   { [ "$HOOK_QUIET" = "0" ] && echo "<<OMNISPARK-VISIBLE-END>>"; }
rule()          { [ "$HOOK_QUIET" = "0" ] && printf "═%.0s" {1..79} && echo; }
gate_row() {
    # gate_row "Gate N — name" "STATUS" "elapsed-or-blank"
    #
    # NOTE: printf "%-Ns" counts BYTES not display columns; with multi-byte
    # UTF-8 em-dashes in the label string a width spec would corrupt the
    # truncation. We accept slightly-uneven [STATUS] columns rather than
    # mangled UTF-8 — the human reader is still well served.
    local label="$1" status="$2" elapsed="$3"
    if [ "$HOOK_QUIET" = "0" ]; then
        if [ -n "$elapsed" ]; then
            printf "  ── %s ──── [%s]  %s\n" "$label" "$status" "$elapsed"
        else
            printf "  ── %s ──── [%s]\n" "$label" "$status"
        fi
    else
        printf "[omnispark/pre-commit] %s: %s" "$label" "$status"
        [ -n "$elapsed" ] && printf " (%s)" "$elapsed"
        echo
    fi
}
# Portable elapsed seconds since a start marker (epoch seconds from `date +%s`).
elapsed_s() {
    local start="$1" now
    now=$(date +%s 2>/dev/null || echo "$start")
    # bash arithmetic — safe even if `now` and `start` are equal
    local diff=$(( now - start ))
    if [ "$diff" -lt 1 ]; then
        echo "<1s"
    else
        echo "${diff}s"
    fi
}

# Run if EITHER the routing docs are staged here, OR a sibling repo's docs
# may have shifted (cheap to check; sync_check is read-only and fast).
STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
DOCS_STAGED=0
if echo "$STAGED" | grep -qE '^(README\.md|CONTRIBUTING\.md)$'; then
    DOCS_STAGED=1
fi

# Locate the framework: walk up from CWD looking for a directory with
# .claude/VERSION or omnispark/.claude/VERSION as a sibling.
locate_framework() {
    local dir
    dir=$(pwd)
    while [ "$dir" != "/" ] && [ "$dir" != "" ]; do
        if [ -f "$dir/omnispark/.claude/VERSION" ]; then
            echo "$dir/omnispark"
            return 0
        fi
        if [ -f "$dir/.claude/VERSION" ]; then
            echo "$dir"
            return 0
        fi
        dir=$(dirname "$dir")
    done
    return 1
}

FRAMEWORK=$(locate_framework) || {
    # ───────────────────────────────────────────────────────────────────────
    # Adoption Layer 3 — friendly banner.
    #
    # If we got here, the hook IS wired (core.hooksPath is set or this file
    # is symlinked into .git/hooks/), but the OmniSpark framework workspace
    # itself is not present as a sibling folder. This is the "Member B
    # pulled the repo but never installed OmniSpark on this machine" case.
    #
    # We do NOT block the commit. Member B's work is more important than
    # our adoption metrics. We just show the value pitch once and let them
    # through. They can silence forever with OMNISPARK_INFO_SHOWN=1.
    # ───────────────────────────────────────────────────────────────────────
    if [ "${OMNISPARK_INFO_SHOWN:-0}" = "1" ]; then
        exit 0
    fi
    # cat to stderr so it's visible even when git captures stdout.
    cat >&2 <<'BANNER'

═══════════════════════════════════════════════════════════════════════════════
  hey there 👋  it's OmniSpark.

  Mild observation: this repo is wired for OmniSpark — but your machine
  has not yet had the pleasure of meeting us. A bit awkward!

  Here is what your teammates have been quietly using to look like
  10× engineers in standup:

    ⚡  /jira:pickup-story → branch + tests + PR, all scaffolded
        (this is how they keep leaving for lunch on time)

    🔍  Pre-commit gates that catch hardcoded secrets BEFORE the
        senior dev has to type "please remove this prod token"
        in your code review for the third time

    📚  Reference docs that regenerate themselves when source changes
        (like a cool plant. nobody asks anyone to "sync the README" anymore)

    🧪  AC-to-test mapping auto-posted on every Jira story. PMs read it.
        PMs LIKE IT. We are as surprised as you are.

    🚨  Cross-repo blast-radius analysis. Find out your schema change
        is about to torpedo three other repos BEFORE it torpedoes them.

  Become that person:

      git clone https://github.com/global-data-analytics/lods-omnispark omnispark
      python omnispark/install.py        # ~60 seconds, we promise

  Or open the onboarding guide in Claude Code:  /omni:enable

  ──────────────────────────────────────────────────────────────────────────
  This commit goes through. We are a tip jar, not a turnstile.
  Mute forever:   export OMNISPARK_INFO_SHOWN=1
═══════════════════════════════════════════════════════════════════════════════

BANNER
    exit 0
}

# Phase 2c moved scripts/ out from under .claude/. Try the new path first,
# fall back to the legacy .claude/scripts/ location for older checkouts.
if [ -f "$FRAMEWORK/scripts/validate_repo_docs.py" ]; then
    VALIDATOR="$FRAMEWORK/scripts/validate_repo_docs.py"
    SYNC_CHECK="$FRAMEWORK/scripts/sync_check.py"
else
    VALIDATOR="$FRAMEWORK/.claude/scripts/validate_repo_docs.py"   # legacy fallback
    SYNC_CHECK="$FRAMEWORK/.claude/scripts/sync_check.py"           # legacy fallback
fi
if [ ! -f "$VALIDATOR" ]; then
    echo "[omnispark/pre-commit] ERROR: validator script missing: $VALIDATOR" >&2
    exit 1
fi
if [ ! -f "$SYNC_CHECK" ]; then
    echo "[omnispark/pre-commit] ERROR: sync_check script missing: $SYNC_CHECK" >&2
    exit 1
fi

# Pick the python interpreter — prefer python, fall back to python3.
if command -v python >/dev/null 2>&1; then
    PYTHON=python
elif command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
else
    echo "[omnispark/pre-commit] ERROR: no python on PATH" >&2
    exit 1
fi

# Emit the passive adoption signal (commit.recorded event) BEFORE any gate
# runs. This way the event is captured even if a later gate blocks the
# commit — we want to count attempts, not just successes. Best-effort:
# failures here never block the commit, never surface error output. The
# emitter itself is also defensively coded to silently no-op on any error
# (see scripts/emit_commit_event.py docstring).
if [ -f "$FRAMEWORK/scripts/emit_commit_event.py" ]; then
    "$PYTHON" "$FRAMEWORK/scripts/emit_commit_event.py" >/dev/null 2>&1 || true
fi

# Read framework version for the banner. Best-effort — never block the
# hook on this lookup; just fall back to "?" if VERSION isn't there.
FW_VERSION="?"
if [ -f "$FRAMEWORK/VERSION" ]; then
    FW_VERSION=$(cat "$FRAMEWORK/VERSION" 2>/dev/null | head -n1 | tr -d '[:space:]')
    [ -z "$FW_VERSION" ] && FW_VERSION="?"
fi
STAGED_COUNT=$(echo "$STAGED" | grep -cE '.' 2>/dev/null || echo 0)

# Opening banner — rich for interactive, single line for CI.
visible_begin
if [ "$HOOK_QUIET" = "0" ]; then
    rule
    printf "  OmniSpark pre-commit  ·  framework v%s  ·  %s staged file(s)\n" \
        "$FW_VERSION" "$STAGED_COUNT"
    rule
    echo
else
    echo "[omnispark/pre-commit] framework v$FW_VERSION · $STAGED_COUNT staged file(s)"
fi

# Gate 1: per-repo doc validity (fires when README/CONTRIBUTING are staged).
#
# IMPORTANT: `set -e` at the top of this script means a bare non-zero
# exit from VALIDATOR/SYNC_CHECK would abort before RC1/RC2 are captured
# and BEFORE the verdict block + remediation print. We capture exit code
# via `if ... ; then` form — bash exempts commands in `if` conditions
# from `set -e`, so non-zero returns flow into the else branch instead
# of killing the script.
RC1=0
G1_START=$(date +%s 2>/dev/null || echo 0)
if [ "$DOCS_STAGED" = "1" ]; then
    if "$PYTHON" "$VALIDATOR" --path "$(git rev-parse --show-toplevel)" --quiet; then
        RC1=0
        gate_row "Gate 1 — Repo doc validity" "OK" "$(elapsed_s $G1_START)"
    else
        RC1=$?
        gate_row "Gate 1 — Repo doc validity" "FAIL" "$(elapsed_s $G1_START)"
    fi
else
    gate_row "Gate 1 — Repo doc validity" "SKIP no docs staged" ""
fi

# Gate 2: workspace-wide sync (always — cheap; protects against drift in any
# direction, even when this commit doesn't touch docs but a sibling did).
G2_START=$(date +%s 2>/dev/null || echo 0)
if "$PYTHON" "$SYNC_CHECK" --quiet; then
    RC2=0
    gate_row "Gate 2 — Workspace sync check" "OK" "$(elapsed_s $G2_START)"
else
    RC2=$?
    gate_row "Gate 2 — Workspace sync check" "DRIFT" "$(elapsed_s $G2_START)"
fi

# OMNISPARK_AUTO_FIX turns the hook into "auto-heal then continue":
# if Gate 2 reports drift, run sync_apply, re-stage any files it changed,
# and fall through to a re-check. The original commit goes through
# carrying both the user's edits AND the regenerated artifacts.
#
# Default policy (overridable via explicit OMNISPARK_AUTO_FIX env var):
#   - Interactive TTY (developer at a terminal) → AUTO_FIX=1  (smooth dev loop)
#   - CI runner ($CI or $GITHUB_ACTIONS set)    → AUTO_FIX=0  (reproducible, reviewable)
#   - Anything else (cron, non-TTY scripts)     → AUTO_FIX=0  (strict default)
if [ -n "${OMNISPARK_AUTO_FIX+x}" ]; then
    AUTO_FIX="$OMNISPARK_AUTO_FIX"                          # explicit override wins
elif [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ]; then
    AUTO_FIX="0"                                             # CI: strict
elif [ -t 1 ]; then
    AUTO_FIX="1"                                             # interactive TTY: ergonomic
else
    AUTO_FIX="0"                                             # non-TTY non-CI: strict
fi

AUTO_HEALED=0
if [ $RC2 -ne 0 ] && [ "$AUTO_FIX" = "1" ]; then
    # Same Phase 2c path migration as VALIDATOR / SYNC_CHECK above.
    if [ -f "$FRAMEWORK/scripts/sync_apply.py" ]; then
        SYNC_APPLY="$FRAMEWORK/scripts/sync_apply.py"
    else
        SYNC_APPLY="$FRAMEWORK/.claude/scripts/sync_apply.py"   # legacy fallback
    fi
    if [ -f "$SYNC_APPLY" ]; then
        AH_START=$(date +%s 2>/dev/null || echo 0)
        "$PYTHON" "$SYNC_APPLY" >/dev/null 2>&1 || true

        # Re-stage every regenerable artifact, capture what changed for the
        # visibility summary at the end of the hook run.
        WS_ROOT="$(dirname "$FRAMEWORK")"
        AUTO_FIXED_FILES=""

        _stage_if_changed() {
            local f="$1"
            if [ -f "$f" ]; then
                # Was it actually modified by sync_apply? (cheap diff against index)
                if ! git diff --quiet -- "$f" 2>/dev/null; then
                    git add "$f" 2>/dev/null || true
                    rel="${f#$WS_ROOT/}"
                    AUTO_FIXED_FILES="${AUTO_FIXED_FILES}${rel}, "
                fi
            fi
        }

        _stage_if_changed "$WS_ROOT/.workspace/routing_index.json"
        _stage_if_changed "$WS_ROOT/.workspace/workspace.json"
        _stage_if_changed "$WS_ROOT/.workspace/architecture.md"
        # Per-repo READMEs that SPARK-6 may have touched.
        for r in "$WS_ROOT"/*/README.md "$WS_ROOT"/*/CONTRIBUTING.md; do
            _stage_if_changed "$r"
        done
        # Copilot prompts SPARK-5 may have written (treated as a directory, not
        # per-file diffed — small write set).
        if [ -d "$FRAMEWORK/.github/prompts" ]; then
            git add "$FRAMEWORK/.github/prompts" 2>/dev/null || true
        fi
        gate_row "Auto-heal — sync_apply.py" "OK" "$(elapsed_s $AH_START)"
        if [ -n "$AUTO_FIXED_FILES" ]; then
            AUTO_FIXED_FILES="${AUTO_FIXED_FILES%, }"
            if [ "$HOOK_QUIET" = "0" ]; then
                echo "       re-staged:  $AUTO_FIXED_FILES"
            else
                echo "[omnispark/pre-commit] auto-fixed: $AUTO_FIXED_FILES"
            fi
        fi

        # Same `if … ; then … else … fi` wrapping as Gate 2 — bare invocation
        # would abort the hook on non-zero under `set -e`.
        G2R_START=$(date +%s 2>/dev/null || echo 0)
        if "$PYTHON" "$SYNC_CHECK" --quiet; then
            RC2=0
            gate_row "Gate 2 (re-check)" "OK" "$(elapsed_s $G2R_START)"
            AUTO_HEALED=1
        else
            RC2=$?
            gate_row "Gate 2 (re-check)" "DRIFT" "$(elapsed_s $G2R_START)"
        fi
    fi
fi

RC=0
if [ $RC1 -ne 0 ] || [ $RC2 -ne 0 ]; then
    RC=1
    # Closing block: visible BLOCK banner + remediation. Remediation goes
    # to stderr (preserved from the original) so it's visible even when
    # git captures stdout. The stdout side gets the BLOCK verdict line
    # inside the visible markers; stderr gets the help text.
    if [ "$HOOK_QUIET" = "0" ]; then
        echo
        rule
        echo "  VERDICT: BLOCK — workspace sync drift"
        rule
    else
        echo "[omnispark/pre-commit] BLOCK"
    fi
    echo "" >&2
    if [ $RC1 -ne 0 ]; then
        echo "  Per-repo doc validity failed for this repo." >&2
        echo "  Inspect:      $PYTHON $VALIDATOR --path ." >&2
        echo "" >&2
    fi
    if [ $RC2 -ne 0 ]; then
        echo "  One or more registered repos have README/CONTRIBUTING frontmatter" >&2
        echo "  that no longer matches .workspace/routing_index.json." >&2
        echo "" >&2
        echo "  Auto-heal once:" >&2
        echo "    $PYTHON $FRAMEWORK/scripts/sync_apply.py" >&2
        echo "    git commit  # re-stages regenerated artifacts for you" >&2
        echo "" >&2
        if [ "$AUTO_FIX" != "1" ]; then
            echo "  Enable auto-heal for this dev (permanent):" >&2
            echo "    export OMNISPARK_AUTO_FIX=1   # add to your shell profile" >&2
            echo "" >&2
        fi
        echo "  Bypass once (CI will still catch the drift):" >&2
        echo "    OMNISPARK_SKIP_HOOK=1 git commit" >&2
    fi
    visible_end
    exit $RC
fi

# Success path — explicit PASS verdict so the team member sees proof the
# gates ran (today's silent exit on PASS left them guessing).
if [ "$HOOK_QUIET" = "0" ]; then
    echo
    rule
    if [ $AUTO_HEALED -eq 1 ]; then
        echo "  VERDICT: PASS — auto-healed, commit may proceed"
    else
        echo "  VERDICT: PASS — commit may proceed"
    fi
    rule
else
    if [ $AUTO_HEALED -eq 1 ]; then
        echo "[omnispark/pre-commit] PASS (auto-healed)"
    else
        echo "[omnispark/pre-commit] PASS"
    fi
fi
visible_end
exit 0
